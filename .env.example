# Telegram Bot 配置
TG_BOT_TOKEN=
TG_ALLOWED_CHAT_ID=*******

# Jenkins 配置
JENKINS_URL=
JENKINS_USER=
JENKINS_API_TOKEN=

# 构建默认参数
DEFAULT_BRANCH=main
DEFAULT_NAMESPACE=testa
DEFAULT_PUSH_LATEST=true
DEFAULT_RUN_GO_TEST=false

# 安全控制，可选，逗号分隔 Telegram 用户 ID。为空表示群内所有成员都可以触发。
ALLOWED_USER_IDS=

# 轮询间隔
POLL_INTERVAL_SECONDS=2
REQUEST_TIMEOUT_SECONDS=15
